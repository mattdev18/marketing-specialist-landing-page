# Copy to .env (never commit .env). All values are PUBLIC-by-design
# values only — secrets stay server-side / with the form provider.

# Contact form endpoint (Formspree AJAX URL or your serverless endpoint)
VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Cloudflare Turnstile public SITE key (secret key stays on the server)
VITE_TURNSTILE_SITE_KEY=

# Plausible analytics domain (analytics load only after visitor consent)
VITE_PLAUSIBLE_DOMAIN=
